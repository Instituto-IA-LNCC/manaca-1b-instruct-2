# syntax=docker/dockerfile:1
# =============================================================================
# Manacá — Imagem GPU: Fase 3 (SFT + DPO com trl/accelerate/deepspeed)
# =============================================================================
# Substitui "module load cuda + conda activate manaca-sft + Singularity + srun"
# (references/phase3-sft §57.5) por Docker. accelerate launch roda dentro do
# container; multinó via variáveis MAIN_PROCESS_IP/MACHINE_RANK (ver docs).
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:24.12-py3
FROM ${BASE_IMAGE}

# DNS_SERVERS (lista separada por espaco, ex.: "1.1.1.1 8.8.8.8"): alguns
# hosts (ex.: systemd-resolved com stub 127.0.0.53 no /etc/resolv.conf) nao
# tem esse endereco alcancavel de dentro do container mesmo com
# --network=host no build, e `docker build` nao aceita --dns como
# `docker run` aceita. Sobrescrevemos /etc/resolv.conf DENTRO do mesmo RUN
# que precisa de rede (Docker remonta esse arquivo a cada novo container/
# step, entao so persiste assim). Passe via:
#   docker build --build-arg DNS_SERVERS="$(resolvectl dns | ...)" ...
# (ja automatizado em `make build-posttrain`). Vazio = usa o resolv.conf
# padrao do container, sem alteracao.
#
# `options single-request-reopen` E OBRIGATORIO, nao cosmetico: o glibc
# resolve A/AAAA em paralelo por UDP, e em alguns clusters (HPC LNCC/Netuno
# incluso) esse par de consultas as vezes perde pacote -- getaddrinfo()
# funciona uma chamada e falha na proxima PRO MESMO host (exatamente o
# sintoma visto: `python3 -c "socket.getaddrinfo('pypi.org', ...)"` ok, e o
# pip, segundos depois, "Name or service not known" pro mesmo pypi.org).
# Mesma causa-raiz e mesma correcao ja usadas em scripts/docker/run_sft.sh
# e run_posttrain.sh (repo manaca-1b-instruct) para os containers de
# `docker run`; aqui replicamos pro `docker build`, que nao aceita bind-
# mount de resolv.conf.
ARG DNS_SERVERS=""

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    WORK_DIR=/workspace/manaca-corpus \
    HF_HOME=/workspace/hf-cache \
    CKPT_DIR=/workspace/checkpoints \
    TOKENIZERS_PARALLELISM=false \
    NCCL_DEBUG=WARN

RUN if [ -n "${DNS_SERVERS}" ]; then \
        : > /etc/resolv.conf; \
        for ns in ${DNS_SERVERS}; do echo "nameserver ${ns}" >> /etc/resolv.conf; done; \
        echo "nameserver 127.0.0.53" >> /etc/resolv.conf; \
        echo "options single-request-reopen timeout:2 attempts:5" >> /etc/resolv.conf; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/posttrain.txt requirements/corpus.txt /tmp/requirements/
# A imagem base NGC ja aponta um indice pip extra (pypi.ngc.nvidia.com) que
# so tem registro AAAA neste cluster e trava o pip mesmo com o resto do DNS
# corrigido -- mesmo problema e mesma correcao documentados em
# scripts/eval/build_lmeval_image.sh: remove qualquer pip.conf que aponte
# pra ele e zera PIP_INDEX_URL/PIP_EXTRA_INDEX_URL so para este install.
RUN if [ -n "${DNS_SERVERS}" ]; then \
        : > /etc/resolv.conf; \
        for ns in ${DNS_SERVERS}; do echo "nameserver ${ns}" >> /etc/resolv.conf; done; \
        echo "nameserver 127.0.0.53" >> /etc/resolv.conf; \
        echo "options single-request-reopen timeout:2 attempts:5" >> /etc/resolv.conf; \
    fi; \
    find /etc /root /usr -maxdepth 4 -name 'pip.conf' -not -path '*/site-packages/*' -delete 2>/dev/null || true; \
    PIP_INDEX_URL= PIP_EXTRA_INDEX_URL= python -m pip install --index-url https://pypi.org/simple \
        --retries 20 --timeout 120 \
        -r /tmp/requirements/posttrain.txt -r /tmp/requirements/corpus.txt

WORKDIR /workspace/manaca

COPY docker/entrypoint.sh /usr/local/bin/manaca-entrypoint
RUN chmod +x /usr/local/bin/manaca-entrypoint
ENTRYPOINT ["/usr/local/bin/manaca-entrypoint"]

CMD ["python", "-c", "import torch, trl, transformers; print('trl', trl.__version__, '| transformers', transformers.__version__, '| CUDA', torch.cuda.is_available())"]
